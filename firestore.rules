rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'vanviolet.js@gmail.com');
    }

    function isOwner(authorId) {
      return isAuthenticated() && request.auth.uid == authorId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Articles
    match /articles/{articleId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || isOwner(resource.data.authorId);
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
    }

    // Vanpedia Terms
    match /vanpedia/{termId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() || isOwner(resource.data.authorId);
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
    }

    // Technical Questions / Issues & Forum Threads
    match /questions/{questionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Answers to Questions
    match /answers/{answerId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
    }

    // Article Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
    }

    // Article Likes & Reactions
    match /article_likes/{slug} {
      allow read: if true;
      allow write: if true;
    }

    // Content Reports (Error / Inaccuracy reports on articles & vanpedia)
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Categories Master Data
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Direct Contact Messages & Inquiries
    match /messages/{messageId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
